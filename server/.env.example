# ─── Servidor Domino Online — variables de entorno ───
# Copia este archivo a `server/.env` y rellena los valores.
# NUNCA subas server/.env al repositorio (está en .gitignore).

# Puerto HTTP/Socket.IO
PORT=3001

# Segundos por turno (mínimo 5)
TURN_SECONDS=30

# ─── Seguridad / hardening ───
# Orígenes permitidos por CORS, separados por comas (dominio del cliente en
# producción). Si se deja VACÍO, el CORS queda ABIERTO (*), cómodo en desarrollo
# y red local pero NO recomendado en producción.
CLIENT_ORIGINS=
# Tope global de salas simultáneas (cortafuegos anti-DoS). Por defecto 3000.
MAX_ROOMS=3000
# Secreto para firmar los tokens de sesión (identidad socket↔jugador).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# OBLIGATORIO si defines DATABASE_URL: el servidor se NIEGA A ARRANCAR sin él.
# Las identidades quedan reclamadas en la BD y sobreviven al reinicio, pero los
# tokens se firman con este secreto: si cambiara en cada arranque, todos los
# jugadores serían rechazados y perderían su cuenta (monedas, skins, ELO,
# amigos) en silencio. Debe ser ESTABLE en el tiempo.
# Sin DATABASE_URL (modo degradado) se genera uno efímero y no pasa nada.
AUTH_SECRET=
# Exigir token verificado en las operaciones económicas (tienda, misiones).
# Con el oráculo de tokens cerrado, la vinculación ya requiere demostrar la
# propiedad, así que esto es una red adicional. Vacío = desactivado.
AUTH_STRICT=

# ─── Base de datos (Postgres / Supabase) ───
# Sin DATABASE_URL el servidor arranca en MODO DEGRADADO:
# sin usuarios, tienda, ranking ni misiones (el juego en sí funciona).
DATABASE_URL=
# Máximo de conexiones del pool (Render 512MB + Supabase → conservador)
DB_POOL_MAX=5
# TLS de la BD. Por defecto no se verifica el certificado (compatible con el
# pooler de Supabase/Render). Para endurecer en producción, define UNA de:
#   DB_SSL_CA   = certificado CA en PEM (o con \n escapados)
#   DB_SSL_STRICT=1  (verifica contra las CA del sistema)
DB_SSL_CA=
DB_SSL_STRICT=

# ─── TURN para voz/vídeo (WebRTC) ───
# Opción A: Cloudflare Realtime TURN (recomendado)
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=

# Opción B: servidor TURN propio (alternativa a Cloudflare)
# TURN_URL admite varias URLs separadas por comas.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
